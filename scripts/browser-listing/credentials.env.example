# Copy these keys into the desktop worker's .env.local. Keep this file private.
# Quote values that contain spaces, #, quotes or other dotenv syntax.
FF_ONBUY_USERNAME=
FF_ONBUY_PASSWORD=
FF_FACEBOOK_MARKETPLACE_USERNAME=
FF_FACEBOOK_MARKETPLACE_PASSWORD=
FF_VINTED_USERNAME=
FF_VINTED_PASSWORD=
FF_GOOGLE_MERCHANT_USERNAME=
FF_GOOGLE_MERCHANT_PASSWORD=

# Amazon uses the API server's .env.local, not the browser credential tool.
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_SELLER_ID=
