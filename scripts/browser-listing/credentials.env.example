# Desktop seller credentials: add values only to the ignored repository .env.local.
# The worker reads these locally and keeps them out of listing packs and API requests.
FF_ONBUY_USERNAME=
FF_ONBUY_PASSWORD=
FF_FACEBOOK_MARKETPLACE_USERNAME=
FF_FACEBOOK_MARKETPLACE_PASSWORD=
FF_VINTED_USERNAME=
FF_VINTED_PASSWORD=

# Google Shopping uses the Merchant API service account configured on the API,
# not these browser login fields. Amazon listings use SP-API on the API service.
