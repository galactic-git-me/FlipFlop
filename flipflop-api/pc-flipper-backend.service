[Unit]
Description=PC Flipper Backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=mac
WorkingDirectory=/home/mac/CODING/FlipFlop/pc-flipper-backend
EnvironmentFile=-/home/mac/CODING/FlipFlop/pc-flipper-backend/.env
ExecStart=/home/mac/CODING/FlipFlop/pc-flipper-backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
