[Unit]
Description=FlipFlop production storefront
After=network-online.target flipflop-production-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mac/CODING/flipflop-shop
Environment=NODE_ENV=production
Environment=BACKEND_URL=http://127.0.0.1:4311
ExecStart=/usr/bin/npm start -- -p 3020
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
