FROM node:20-alpine AS deps
WORKDIR /app
COPY flipflop-admin/package.json flipflop-admin/package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=/api
ARG BACKEND_URL=http://api:4311
ARG GEMRADAR_URL=http://gemradar-worker:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_FLIPFLOP_ENV=live
ENV BACKEND_URL=$BACKEND_URL
ENV GEMRADAR_URL=$GEMRADAR_URL
COPY --from=deps /app/node_modules ./node_modules
COPY flipflop-admin ./
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV BACKEND_URL=http://api:4311
ENV GEMRADAR_URL=http://gemradar-worker:8000
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=30s \
    CMD wget --quiet --tries=1 --spider http://localhost:3000/health || exit 1
CMD ["node", "server.js"]
